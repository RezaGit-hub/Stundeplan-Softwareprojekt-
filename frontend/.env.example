# Kopie als .env.local anlegen, wenn nötig. Ohne Datei: echter Client gegen /api (Vite-Proxy → localhost:8080).
# Ziel des Vite-Proxys für /api. Nur im Entwicklungsserver wirksam; im Produktionsbuild macht das nginx
# (deployment/nginx.conf). Standard ohne Zeile: http://localhost:8080. .env.prism setzt hier den Prism-Mock ein.
# VITE_PROXY_TARGET=http://localhost:8080
# Attrappe statt Backend (wie `npm run dev:mock`):
# VITE_MOCK=true
# Datensatz der Attrappe: SMALL (Pflichtenheft-Testdaten, Standard) oder FULL (12 Klassen / 24 Lehrkräfte / 18 Räume)
# VITE_MOCK_DATASET=SMALL
# Festes „Heute" für deterministische Screenshots (yyyy-MM-dd); leer = echtes Datum
# VITE_MOCK_TODAY=2026-09-21
# Kunstlatenz der Attrappe in ms; leer = 150–400 ms zufällig
# VITE_MOCK_LATENCY=0
# Leitszenario beim Start vorlegen (Entwurf, Ereignisse Meyer/R101, Vertretung 7a 1. Stunde)
# VITE_MOCK_SCENARIO=leitszenario
# Hash-Router (nur für die Ein-Datei-Demo, wird von .env.demo gesetzt)
# VITE_HASH_ROUTER=true
