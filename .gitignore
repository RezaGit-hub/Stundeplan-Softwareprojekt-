# Wurzel-Ignorierliste. backend/.gitignore und frontend/.gitignore gelten zusaetzlich.

# Zugangsdaten und Betriebsdaten — gehoeren nie ins Repo.
deployment/.env
deployment/backups/
*.local
deployment/certs/

# Abhaengigkeiten und Baustaende
**/node_modules/
**/dist/
**/build/
**/.gradle/
**/.npm/

# Aussenstehende Ordner (Demo-Datei fuer adesso, Zwischenstaende von Agenten)
/demo/
.agent-out/

# Betriebssystem und Editoren
.DS_Store
Thumbs.db
.idea/
.vscode/
sammler.py
zentrale_sammlung.md
frontend/zentrale_sammlung_frontend.md
backend/zentrale_sammlung_backend.md

# Ausgaben des Playwright-MCP (Snapshots, Konsolenprotokolle) — nur lokal
.playwright-mcp/
