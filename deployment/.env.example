# Vorlage fuer deployment/.env — kopieren, Werte setzen, NICHT ins Repo committen:
#
#   cd deployment && cp -n .env.example .env
#
# docker compose liest .env automatisch, wenn die Befehle aus diesem Ordner kommen.

# Erstes Passwort des Kontos `admin`. Pflicht: ohne diesen Wert startet der Stack nicht.
# Gilt nur beim allerersten Start (leere Datenbank). Danach aendert man das Passwort in der App.
#
# Zeichen: nur A-Za-z0-9._- verwenden (Befund BETRIEB-10, 05.09.). Die Skripte deployment/backup.sh,
# scripts/dev-backend.sh und deployment/beispieldaten.sh lesen diese Datei als Shell-Skript; ein Wert
# mit Leerzeichen, `#`, `$` oder Anfuehrungszeichen bricht dort ab oder wird anders ausgelegt als von
# docker compose. Laenge macht ein Kennwort sicher, Sonderzeichen sind hier nicht noetig.
#
# Der Beispielwert unten ist ein Platzhalter: bleibt er stehen, verweigert das Backend im Profil prod
# den Start (Befund SICHERHEIT-6). In den Profilen dev und ci geht er mit einer Warnung durch.
ADMIN_INITIAL_PASSWORD=bitte-aendern

# Datenbank (Container `db`, nach aussen nur mit docker-compose.dev.yml sichtbar).
DB_NAME=timetable
DB_USER=tt
DB_PASSWORD=tt

# Nur mit docker-compose.dev.yml: unter diesem Port liegt die Datenbank auf dem eigenen Rechner.
DB_PORT=15432

# Nach aussen veroeffentlichter Port der Web-App.
# Auf der VM Gruppe 5 stattdessen WEB_PORT=8080 setzen — die VM-NAT macht daraus von aussen 1500
# (http://134.245.1.240:1500).
#WEB_PORT=1500
WEB_PORT=8080
# Port der Prism-Attrappe. Wirkt nur mit docker-compose.dev.yml; der regulaere Stack startet sie nicht
# (sie ist eine API-Attrappe und gehoert nicht zum Produkt).
MOCK_PORT=1501

# Nur fuer den Betrieb mit fertigen Abbildern aus der GitLab-Registry (Job `image:build`).
# Leer lassen heisst: `docker compose up --build` baut selbst, die Abbilder heissen dann
# stundenplan/backend:latest und stundenplan/web:latest.
# REGISTRY_IMAGE=cau-git.rz.uni-kiel.de:5050/ifi-ag-se/softwareprojekt/wsp3_1/web-app
# IMAGE_TAG=latest
